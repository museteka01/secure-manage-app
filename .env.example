# Copy this file to .env and fill in real values. NEVER commit .env.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used by docker compose for the PostgreSQL container
POSTGRES_USER=secure_manage
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=secure_manage

# For running the API directly on your machine (outside Docker):
DATABASE_URL=postgresql://secure_manage:replace-me-with-a-strong-password@localhost:5432/secure_manage
